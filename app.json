{
  "expo": {
    "name": "Blood Hive",
    "slug": "blood-hive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "bloodhive",
    "userInterfaceStyle": "automatic", 
    
    
    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png", 
        "backgroundColor": "#FF0000" 
      },
      "predictiveBackGestureEnabled": false, 
      "package": "com.vexplaysgames.bloodhive",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAsm5O59l9D08wEEIycr-I0mO3HVZ2iDJ0"
        }
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "2552bd13-3ec7-4f86-b323-d2fb1cfd1bb1"
      }
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/2552bd13-3ec7-4f86-b323-d2fb1cfd1bb1" 
    }
  }
}